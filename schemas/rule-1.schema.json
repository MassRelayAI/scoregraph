{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MassRelayAI/scoregraph/schemas/rule-1.schema.json",
  "title": "rule/1",
  "description": "A versioned, executable rule with a red and a green fixture. The id starts with its family.",
  "type": "object",
  "required": ["schema", "id", "version", "title", "family", "kind", "mode", "weight", "check", "red", "green", "owner"],
  "additionalProperties": false,
  "$defs": {
    "check": {
      "oneOf": [
        {"type": "object", "required": ["all"], "additionalProperties": false, "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}}},
        {"type": "object", "required": ["any"], "additionalProperties": false, "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}}},
        {"type": "object", "required": ["not"], "additionalProperties": false, "properties": {"not": {"$ref": "#/$defs/check"}}},
        {
          "type": "object",
          "required": ["fact", "op"],
          "additionalProperties": false,
          "properties": {
            "fact": {"type": "string", "minLength": 1},
            "op": {"enum": ["eq", "ne", "lt", "le", "gt", "ge", "in", "contains", "exists", "absent"]},
            "value": {}
          }
        }
      ]
    },
    "fixture": {
      "oneOf": [
        {"type": "string", "description": "a path inside the ruleset to a file holding {\"facts\": {...}}"},
        {"type": "object", "required": ["facts"], "properties": {"facts": {"type": "object"}}}
      ]
    }
  },
  "properties": {
    "schema": {"const": "rule/1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "family": {"enum": ["feature", "ui", "nav", "flow", "quality", "judged"]},
    "kind": {"enum": ["deterministic", "judged"]},
    "mode": {"enum": ["advisory", "warn", "blocking"]},
    "weight": {"type": "number", "exclusiveMinimum": 0},
    "check": {"$ref": "#/$defs/check"},
    "partial": {"$ref": "#/$defs/check"},
    "red": {"$ref": "#/$defs/fixture"},
    "green": {"$ref": "#/$defs/fixture"},
    "owner": {"type": "string", "minLength": 1},
    "source_feedback": {"type": "array", "items": {"type": "string"}},
    "features": {"type": "array", "items": {"type": "string"}, "description": "CompareGraph feature ids this rule proves"},
    "state": {"enum": ["active", "draft", "retired"], "default": "active"},
    "decision": {"type": "string", "description": "the decision/1 id that allowed a retirement, a loosening or a judged rule to block"},
    "supersedes": {"type": "string"},
    "judge_digest": {"type": "string"}
  }
}
